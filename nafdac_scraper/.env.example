# =============================================================================
# NAFDAC Greenbook weekly refresh — environment variables
# =============================================================================
# Copy to `.env` for a local run, or paste the same keys into the Render
# dashboard (Environment tab) for the deployed web service. On Render, real
# environment variables are what the service reads; a `.env` is only used when
# running locally and is git-ignored.
#
# The refresh service, the scraper and the loader together read every key below.
# Only NAFDAC_DATABASE_URL and NAFDAC_REFRESH_API_KEY matter for a working
# deployment; the rest have sensible defaults.
# =============================================================================


# --- REQUIRED ---------------------------------------------------------------

# Hosted PostgreSQL DSN, read by nafdac_source.load_postgres. This is the same
# database the N-ATLaS server reads: the session pooler on port 5432. The
# password contains '@' and '&', so it MUST stay percent-encoded (%40, %26).
# NEVER commit a real value. Mark as Secret in Render.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
NAFDAC_DATABASE_URL=

# Bearer token required by POST /run and GET /logs. Any long random string.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left empty, /run and /logs return 403 but the weekly schedule still runs.
# Mark as Secret in Render.
NAFDAC_REFRESH_API_KEY=


# --- WEEKLY SCHEDULE --------------------------------------------------------
# Defaults below run the job every Sunday at midnight Nigeria time (WAT).
# NAFDAC_REFRESH_DOW is mon..sun; HOUR is 0-23; MINUTE is 0-59 in the given
# timezone. Set all three consistently with NAFDAC_REFRESH_TIMEZONE.
NAFDAC_REFRESH_DOW=sun
NAFDAC_REFRESH_HOUR=0
NAFDAC_REFRESH_MINUTE=0
# IANA timezone. Africa/Lagos is WAT (UTC+1), matching "midnight Nigeria time".
NAFDAC_REFRESH_TIMEZONE=Africa/Lagos


# --- TLS WORKAROUND (temporary) ---------------------------------------------
# NAFDAC's *.nafdac.gov.ng certificate expired 2026-11-06. While it is expired,
# set this to 1 so the scrape can run; verification would otherwise fail.
# REMOVE / unset it once NAFDAC renews the certificate. TLS is verified by
# default.
NAFDAC_SCRAPER_INSECURE_TLS=


# --- OPTIONAL ---------------------------------------------------------------
# Explicit paths to the greenbook export. Leave empty and the scraper writes to,
# and the loader auto-detects, nafdac_scraper/nafdac_greenbook.csv and .xlsx.
NAFDAC_CSV_PATH=
NAFDAC_XLSX_PATH=

# Fallback name for the database DSN if NAFDAC_DATABASE_URL is not set.
DATABASE_URL=


# --- RUNTIME (Render build/runtime, not read by the app) --------------------
# Python version Render should use.
PYTHON_VERSION=3.12
