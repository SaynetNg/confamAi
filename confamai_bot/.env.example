# =============================================================================
# Confam AI WhatsApp bot — EXAMPLE configuration
# =============================================================================
# Copy to confamai_bot/.env (or the project-root .env) and fill in real values.
#
#     copy confamai_bot/.env.example confamai_bot/.env     # Windows
#     cp  confamai_bot/.env.example confamai_bot/.env      # Linux / macOS
#
# Real environment variables always win over this file, so a container with
# env vars injected is never overridden by a stray copy on disk.
#
# NEVER commit the filled-in version. It holds a live WhatsApp token and a live
# N-ATLaS API key.
# =============================================================================

# --- WhatsApp Cloud API ------------------------------------------------------
# From developers.facebook.com -> your app -> WhatsApp -> API Setup.
# The token must be a System User permanent token. A dashboard temporary token
# expires after about a day, which is discovered the hard way.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Echoed back by Meta during webhook subscription. Any unguessable string;
# invent one, do not reuse anything else.
WHATSAPP_VERIFY_TOKEN=

# App secret, from your Meta app's Basic Settings. Enables X-Hub-Signature-256
# validation on every inbound POST. Strongly recommended on a public number:
# without it, anyone who learns the webhook URL can inject fake customer
# messages. Leave empty and the bot still runs, but /healthz will say the
# signature check is off.
WHATSAPP_APP_SECRET=

WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_PATH=/webhook

# --- N-ATLaS server ----------------------------------------------------------
# The API that answers product questions. No model runs here.
N_ATLAS_BASE_URL=https://ai.saynet.ng/v1
N_ATLAS_API_KEY=KgRRl_6vEp7YRCY6agQ9HjH0RFk6T6hr9KYQq7YTRfRrKeWQIyFs_biogXFvK_Lo

N_ATLAS_MODEL=n-atlas

# A Tesla T4 turn takes roughly 13 seconds, including the server's intent
# extraction. Do not set this low: a timeout here produces "verification is
# temporarily unavailable" for a question that was about to be answered.
N_ATLAS_TIMEOUT=180

# The server clamps at its own max_new_tokens (512 on the current deployment).
N_ATLAS_MAX_TOKENS=512
N_ATLAS_TEMPERATURE=0.7

# Retries for 429/5xx/timeouts only. Never applied to 401/403/400/422.
N_ATLAS_MAX_RETRIES=2

# --- Throughput --------------------------------------------------------------
# One shared GPU serves every request, so this is a queue, not a pool. 3 keeps
# the pipeline busy without making a T4 thrash. Raising it past ~6 mostly buys
# 507s.
WHATSAPP_MAX_CONCURRENCY=3

# How long a turn may wait for a slot before the user is told the server is
# busy. Without this bound a stuck request holds a slot forever and the bot
# degrades to zero throughput with nothing in the logs.
WHATSAPP_PER_USER_TIMEOUT=120

# --- Sessions ----------------------------------------------------------------
# sqlite     one local file. Fine for one process on one host.
# supabase   makes the bot stateless. Use this if there is any chance of more
#            than one instance, or if the host disk is ephemeral.
WHATSAPP_SESSION_BACKEND=sqlite

# Matches Meta's 24-hour customer service window. Enforced by the sweeper, not
# just documented: expired conversations are deleted on a schedule.
WHATSAPP_SESSION_TTL_HOURS=24

# The server has a finite context budget and its own message-count limit, so an
# untrimmed history eventually fails every request.
WHATSAPP_MAX_HISTORY_MESSAGES=12
WHATSAPP_MAX_HISTORY_TOKENS=2000

# Inbound text is truncated to this before being sent upstream, so one pasted
# wall of text cannot blow the context budget on the next turn.
WHATSAPP_MAX_MESSAGE_CHARS=4000

WHATSAPP_SQLITE_PATH=sessions.db

# Only for WHATSAPP_SESSION_BACKEND=supabase. May be the same Supabase project
# that holds the NAFDAC greenbook, but the bot uses its own schema
# (WHATSAPP_SESSION_SCHEMA) and must not be able to reach the greenbook tables.
# WHATSAPP_SESSION_DSN=postgresql://USER:PASSWORD@HOST:5432/postgres
WHATSAPP_SESSION_SCHEMA=confamai_bot

# --- Behaviour ---------------------------------------------------------------
# One short line sent immediately, because a T4 turn takes ~13s and an
# unexplained pause reads as a broken bot. Free inside the customer's 24-hour
# window.
WHATSAPP_SEND_ACK=true

# Pin the acknowledgement wording, or switch it off. Leave empty to auto-pick a
# language. Off values: 0, off, no, none, false, disable, disabled.
WHATSAPP_ACK_TEXT=

# --- Server defect workaround ----------------------------------------------
# The current server build attaches the verified NAFDAC block for a message
# holding a number, then ignores it and asks which product to verify, when the
# message has no interrogative. "A4-100160", "check A4-100160" and "verify this
# number A4-100160" all fail that way; 4/4 failures at temperature 0.7 and 4/4
# at 0.1, so it is deterministic rather than sampling noise. It is also the
# most common way anyone uses a verification service.
#
# With this on, such a turn gets one extra instruction line appended. It names no
# product, no verdict and no number, and it is added only when the user's own
# text already contains a NAFDAC number, so greetings are untouched and the
# server's intent gate still refuses retrieval for them (measured: a greeting
# moved 599 -> 644 prompt tokens, which is the frame text itself; a real
# greenbook block adds about 1000).
#
# Set this to false once `NAFDAC_INSTRUCTION` on the server covers bare numbers.
# See confamai_bot/framing.py.
WHATSAPP_VERIFICATION_FRAME=true

# Replace the instruction wording if you want to. Empty uses the default.
# WHATSAPP_VERIFICATION_FRAME_TEXT=

# Restrict the bot to specific numbers, comma-separated E.164. Leave empty to
# allow everyone, which is the right default until the number is public.
# WHATSAPP_ALLOWED_NUMBERS=+2348012345678,+2348098765432

# Technical output. Never prints a secret.
WHATSAPP_DEBUG=false